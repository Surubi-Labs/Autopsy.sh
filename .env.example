# PostgreSQL
POSTGRES_USER=autopsy
POSTGRES_PASSWORD=autopsy
POSTGRES_DB=autopsy
DATABASE_URL=postgresql://autopsy:autopsy@localhost:5432/autopsy

# Redis
REDIS_URL=redis://localhost:6379

# Git storage
DATA_DIR=/data/repos

# OpenAI (optional, for AI-enhanced reports)
OPENAI_API_KEY=

# JWT
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?billing=canceled

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@autopsy.dev

# Dashboard URL (for report links in emails/Slack)
DASHBOARD_BASE_URL=http://localhost:3000
